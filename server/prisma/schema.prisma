generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Placeholder roles — redefine once the domain is specified.
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  name         String?
  phone        String?
  hashPassword String
  role         Role    @default(USER)
  isActive     Boolean @default(true)

  auditLogs AuditLog[]
  otpCodes  OtpCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         Int    @id @default(autoincrement())
  userId     Int
  action     String
  entityType String
  entityId   Int
  details    Json?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

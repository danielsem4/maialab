DATABASE_URL="postgresql://postgres:postgres@localhost:5433/maialab?schema=public"
# Neon only: direct (non-pooled) URL used by the Prisma CLI for migrations
DATABASE_URL_UNPOOLED=
PORT=3001
JWT_SECRET="change-me"
CLIENT_URL="http://localhost:5173"
NODE_ENV=development

# Set to "false" to skip the emailed login code (demo deployments only)
REQUIRE_LOGIN_OTP=true

# AWS SES (optional — emails/OTP codes are logged to console when not configured)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=il-central-1
SMTP_FROM=noreply@hitheal.org.il

# Seed
SEED_ADMIN_EMAIL=admin@maialab.local
SEED_ADMIN_PASSWORD=

# Media uploads (defaults to ./uploads)
UPLOAD_DIR=

# Vercel Blob (optional — when BLOB_BASE_URL is set, uploads go to Blob instead of UPLOAD_DIR)
# BLOB_BASE_URL: the store's public URL, e.g. https://<store-id>.public.blob.vercel-storage.com
BLOB_BASE_URL=
BLOB_READ_WRITE_TOKEN=
